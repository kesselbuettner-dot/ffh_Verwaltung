POSTGRES_DB=ffh_verwaltung
POSTGRES_USER=ffh_verwaltung
POSTGRES_PASSWORD=change-me-to-a-long-random-password
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Marktguru API
# Endpoint documented by the current web client / community integrations:
MARKTGURU_ENDPOINT=https://api.marktguru.de/api/v1/offers/search
# Do NOT commit these values to Git. Obtain/use them only where you are authorized to do so.
MARKTGURU_API_KEY=
MARKTGURU_CLIENT_KEY=
MARKTGURU_ZIP=04109
MARKTGURU_LIMIT=24

# Production release/update
APP_VERSION=1.1.0
GITHUB_REPOSITORY=kesselbuettner-dot/ffh_Verwaltung
# Cloudflare remotely-managed Tunnel token (never commit the real value)
CLOUDFLARE_TUNNEL_TOKEN=
# Random secret shared only between the app and updater container
UPDATER_TOKEN=change-me-to-a-long-random-updater-token

# Zentraler PayPal-Spendenlink des Vereins (Zahlungseingang wird manuell geprüft)
PAYPAL_DONATION_URL=

# Web Push / VAPID (einmalig erzeugen, privaten Schlüssel niemals veröffentlichen)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.org
